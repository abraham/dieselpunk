{
  "name": "@dieselpunk/core",
  "version": "0.0.0",
  "description": "Industrial game-style UI Web Components built with Lit.",
  "type": "module",
  "sideEffects": [
    "./dist/components/*/register.js",
    "./dist/css/*.css"
  ],
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "imports": {
    "#dev": {
      "development": "./dist/utilities/dev.dev.js",
      "default": "./dist/utilities/dev.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./themes.css": "./dist/css/themes.css",
    "./custom-elements.json": "./custom-elements.json",
    "./*/register.js": "./dist/components/*/register.js",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts && npm run build:manifest",
    "build:css": "node scripts/build-css.ts",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "check:contrast": "node scripts/check-contrast.ts",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test \"test/*.test.ts\"",
    "test:browser": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5"
  },
  "customElements": "custom-elements.json"
}
