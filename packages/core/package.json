{
  "name": "@dieselpunk/core",
  "version": "0.4.0",
  "description": "Industrial game-style UI Web Components built with Lit.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://dieselpunk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/dieselpunk.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "./dist/components/*/register.js",
    "./dist/development/components/*/register.js",
    "./dist/css/*.css",
    "./dist/hydrate.js",
    "./dist/development/hydrate.js"
  ],
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/development/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./themes.css": "./dist/css/themes.css",
    "./surfaces.css": "./dist/css/surfaces.css",
    "./custom-elements.json": "./custom-elements.json",
    "./hydrate.js": {
      "types": "./dist/hydrate.d.ts",
      "development": "./dist/development/hydrate.js",
      "default": "./dist/hydrate.js"
    },
    "./ssr.js": {
      "types": "./dist/ssr.d.ts",
      "development": "./dist/development/ssr.js",
      "default": "./dist/ssr.js"
    },
    "./*/register.js": {
      "development": "./dist/development/components/*/register.js",
      "default": "./dist/components/*/register.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "development": "./dist/development/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/inline-tokens.ts && node scripts/minify-css.ts && node scripts/strip-warnings.ts && node scripts/build-css.ts && npm run build:manifest",
    "build:css": "node scripts/build-css.ts",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs && node scripts/compact-manifest.ts",
    "build:pseudo": "node scripts/build-pseudo.ts",
    "check:api": "node scripts/check-api.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:consumer": "node scripts/check-consumer.ts",
    "check:package": "node scripts/check-package.ts && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./themes.css ./surfaces.css",
    "check:size": "node scripts/check-size-reasons.ts && size-limit",
    "test:visual": "node scripts/visual.ts check",
    "test:visual:update": "node scripts/visual.ts update",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test \"test/*.test.ts\"",
    "pretest:browser": "npm run build:manifest && npm run build:pseudo",
    "test:browser": "vitest run",
    "typecheck": "npm run build:pseudo && tsc -p tsconfig.json",
    "check:frameworks": "node scripts/check-frameworks.ts"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@dieselpunk/testing": "^0.0.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.64.1",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/compiler-sfc": "3.5.44",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "0.9.5",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "^14.2.0",
    "svelte": "5.57.2",
    "vitest": "^5.0.5",
    "vue": "3.5.44"
  }
}
