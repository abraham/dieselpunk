[
  {
    "name": "Shared runtime and tokens",
    "path": [
      "dist/internal/punk-element.js",
      "dist/internal/slot-presence.js",
      "dist/tokens/*.js",
      "dist/utilities/register-element.js",
      "dist/utilities/localize.js",
      "dist/utilities/locale.js",
      "dist/utilities/warn.js",
      "dist/styles/*.js",
      "!dist/styles/receptacle.js",
      "!dist/styles/field.js",
      "!dist/styles/close-button.js",
      "!dist/styles/status-shape.js",
      "!dist/styles/gap.js",
      "!dist/styles/modal-surface.js"
    ],
    "ignore": ["lit"],
    "gzip": true,
    "limit": "12 kB"
  },
  {
    "name": "Form control base and field styles (shared by the form controls)",
    "path": ["dist/internal/form-control.js", "dist/internal/fieldset.js", "dist/styles/field.js"],
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "Modal controller and overlay stack (shared by window and dialog)",
