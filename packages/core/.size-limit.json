  {
    "name": "punk-divider",
    "path": "dist/components/divider/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-button",
    "path": "dist/components/button/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-progress-bar",
    "path": "dist/components/progress-bar/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-tooltip",
    "path": "dist/components/tooltip/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
