[
  {
    "name": "Shared runtime and tokens",
    "path": [
      "dist/internal/punk-element.js",
      "dist/internal/slot-presence.js",
      "dist/tokens/*.js",
      "dist/utilities/register-element.js",
      "dist/utilities/localize.js",
      "dist/utilities/locale.js",
      "dist/utilities/warn.js",
      "dist/styles/*.js",
      "!dist/styles/receptacle.js"
    ],
    "ignore": ["lit"],
    "gzip": true,
    "limit": "12 kB"
  },
  {
    "name": "Selectable base and receptacle (shared by slot, item stack, recipe)",
    "path": ["dist/internal/selectable-base.js", "dist/styles/receptacle.js"],
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-panel",
    "path": "dist/components/panel/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-divider",
    "path": "dist/components/divider/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-button",
    "path": "dist/components/button/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-progress-bar",
    "path": "dist/components/progress-bar/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-slot",
    "path": "dist/components/slot/register.js",
    "ignore": ["lit"],
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "punk-item-stack (receptacle, durability, quality, and number formatting)",
    "path": "dist/components/item-stack/register.js",
