{
  "name": "@dieselpunk/testing",
  "version": "0.0.0",
  "private": true,
  "description": "The tooling the other workspaces' tests and gates run on (specs/testing.md §10). Never published.",
  "type": "module",
  "exports": {
    "./browser": "./src/browser.ts",
    "./vitest": "./src/vitest.ts",
    "./playwright": "./src/playwright.ts",
    "./visual": "./src/visual.ts",
    "./server": "./src/server.ts",
    "./consumer": "./src/consumer.ts",
    "./xliff": "./src/xliff.ts",
    "./pseudo": "./src/pseudo.ts",
    "./size": "./src/size.ts",
    "./ci": "./src/ci.ts",
    "./lockfile": "./src/lockfile.ts"
  },
  "scripts": {
    "test": "npm run test:node",
    "test:node": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vitest/browser-playwright": "^5.0.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  }
}
