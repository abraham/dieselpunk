{
  "name": "dieselpunk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run storybook",
    "storybook": "npm run build -w @dieselpunk/core && npm run dev -w @dieselpunk/workbench",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:api": "npm run check:api --workspace @dieselpunk/core",
    "check:contrast": "npm run check:contrast --workspace @dieselpunk/core",
    "check:package": "npm run check:package --workspaces --if-present",
    "check:size": "npm run check:size --workspaces --if-present",
    "check:consumer": "npm run check:consumer --workspace @dieselpunk/core",
    "test:visual": "npm run test:visual --workspace @dieselpunk/core",
    "test:smoke": "npm run test:smoke --workspace @dieselpunk/workbench",
    "test:stories": "npm run test:stories --workspace @dieselpunk/workbench",
    "check:toolchain": "node scripts/check-toolchain.ts",
    "check:lockfile": "node scripts/check-lockfile.ts",
    "check:frameworks": "npm run check:frameworks --workspace @dieselpunk/core",
    "check:strings": "npm run check:strings --workspace @dieselpunk/locales",
    "check:locales": "npm run check:locales --workspace @dieselpunk/locales"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "typescript": "$typescript",
    "@lit/localize-tools": {
      "typescript": "$typescript"
    }
  }
}
